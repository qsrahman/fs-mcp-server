{
  "name": "@qsrahman/fs-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for reading, writing and editing files, running shell commands and (with a Brave API key) searching the web, with switches to restrict it.",
  "main": "dist/index.js",
  "bin": {
    "fs-mcp-server": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "start": "pnpm build && node dist/index.js",
    "watch": "tsc --watch",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm typecheck && pnpm test && pnpm format:check"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "filesystem",
    "files",
    "claude",
    "llm",
    "brave-search",
    "web-search"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qsrahman/fs-mcp-server.git"
  },
  "homepage": "https://github.com/qsrahman/fs-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/qsrahman/fs-mcp-server/issues"
  },
  "author": "Qazi Sami ur Rahman <qsrahmans@gmail.com>",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.4.1",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "diff": "^9.0.0",
    "execa": "^10.2.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22"
  }
}
